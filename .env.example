# Public browser configuration only.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Never place service-role keys or MEMORY_ENCRYPTION_KEY in VITE_ variables.
# Configure these as Supabase Edge Function secrets only:
# MEMORY_ENCRYPTION_KEY=<base64-encoded 32-byte random key>
# APP_ORIGIN=https://your-deployed-domain.example
